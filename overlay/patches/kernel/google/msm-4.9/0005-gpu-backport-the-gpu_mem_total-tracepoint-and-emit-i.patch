From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Tue, 22 Sep 2026 11:27:03 -0400
Subject: [PATCH] gpu: backport the gpu_mem_total tracepoint and emit it from
 kgsl

Android reports GPU memory by attaching gpuMem.bpf to the gpu_mem/
gpu_mem_total tracepoint and pinning map_gpuMem_gpu_mem_total_map, which
libmeminfo reads for both the per-process figures and, at pid 0, the
global total. The tracepoint arrived in 5.4 and does not exist here, so
the program fails to load, libbpf pins nothing, and every reader finds
no map -- which is what system/memory/libmeminfo 0001 had to guard
against to stop system_server aborting.

The trace scaffolding is the upstream 5.4 code: include/trace/events/
gpu_mem.h and drivers/gpu/trace/, which exists only to own
CREATE_TRACE_POINTS and export the symbol. drivers/gpu/Kconfig does not
exist on 4.9, so the new Kconfig is sourced from drivers/video/Kconfig
next to the other drivers/gpu subdirectories, and QCOM_KGSL selects it.

kgsl already keeps the numbers; only the reporting was missing. Per
process, stats[] is summed on each change. For the global figure the
same deltas feed one atomic64, so it is the sum of the per-process
totals by construction rather than a separately derived number that
could drift. Both come from kgsl_trace_gpu_mem(), called from the
allocation path in kgsl_process_add_stats() and the free path in
kgsl_mem_entry_destroy(); the summing loop sits behind
trace_gpu_mem_total_enabled() so it costs nothing when tracing is off.
---
 drivers/gpu/Makefile              |  1 +
 drivers/gpu/msm/Kconfig           |  1 +
 drivers/gpu/msm/kgsl.c            | 28 +++++++++++++++
 drivers/gpu/msm/kgsl_device.h     |  3 ++
 drivers/gpu/trace/Kconfig         |  3 ++
 drivers/gpu/trace/Makefile        |  2 ++
 drivers/gpu/trace/trace_gpu_mem.c | 13 +++++++
 drivers/video/Kconfig             |  2 ++
 include/trace/events/gpu_mem.h    | 57 +++++++++++++++++++++++++++++++
 9 files changed, 110 insertions(+)
 create mode 100644 drivers/gpu/trace/Kconfig
 create mode 100644 drivers/gpu/trace/Makefile
 create mode 100644 drivers/gpu/trace/trace_gpu_mem.c
 create mode 100644 include/trace/events/gpu_mem.h

diff --git a/drivers/gpu/Makefile b/drivers/gpu/Makefile
index f4ebf7783ffc..a7ac8d4fdede 100644
--- a/drivers/gpu/Makefile
+++ b/drivers/gpu/Makefile
@@ -3,5 +3,6 @@
 # to ensure this currently.
 obj-$(CONFIG_TEGRA_HOST1X)	+= host1x/
 obj-y			+= drm/ vga/
+obj-$(CONFIG_TRACE_GPU_MEM)	+= trace/
 obj-$(CONFIG_IMX_IPUV3_CORE)	+= ipu-v3/
 obj-$(CONFIG_QCOM_KGSL) += msm/
diff --git a/drivers/gpu/msm/Kconfig b/drivers/gpu/msm/Kconfig
index b65ed83f093a..df508dbe2f40 100644
--- a/drivers/gpu/msm/Kconfig
+++ b/drivers/gpu/msm/Kconfig
@@ -3,6 +3,7 @@ config QCOM_KGSL
 	default n
 	depends on ARCH_QCOM
 	select GENERIC_ALLOCATOR
+	select TRACE_GPU_MEM
 	select FW_LOADER
 	select PM_DEVFREQ
 	select DEVFREQ_GOV_SIMPLE_ONDEMAND
diff --git a/drivers/gpu/msm/kgsl.c b/drivers/gpu/msm/kgsl.c
index c92c5f3e7a92..cdbd940d4a7f 100644
--- a/drivers/gpu/msm/kgsl.c
+++ b/drivers/gpu/msm/kgsl.c
@@ -45,9 +45,36 @@
 #include "kgsl_compat.h"
 #include "kgsl_pool.h"
 
+#include <trace/events/gpu_mem.h>
+
 #undef MODULE_PARAM_PREFIX
 #define MODULE_PARAM_PREFIX "kgsl."
 
+/*
+ * Sum of every process total, maintained by the same deltas that move
+ * kgsl_process_private.stats, so the global figure and the per-process ones
+ * cannot drift apart. gpu_mem_total reserves pid 0 for the global total.
+ */
+static atomic64_t kgsl_gpu_mem_total;
+
+void kgsl_trace_gpu_mem(struct kgsl_process_private *priv, int64_t delta)
+{
+	uint64_t total = 0;
+	int i;
+
+	atomic64_add(delta, &kgsl_gpu_mem_total);
+
+	if (!trace_gpu_mem_total_enabled())
+		return;
+
+	trace_gpu_mem_total(0, 0, atomic64_read(&kgsl_gpu_mem_total));
+
+	for (i = 0; i < KGSL_MEM_ENTRY_MAX; i++)
+		total += priv->stats[i].cur;
+
+	trace_gpu_mem_total(0, pid_nr(priv->pid), total);
+}
+
 #ifndef arch_mmap_check
 #define arch_mmap_check(addr, len, flags)	(0)
 #endif
@@ -464,6 +491,7 @@ static void kgsl_mem_entry_detach_process(struct kgsl_mem_entry *entry)
 
 	type = kgsl_memdesc_usermem_type(&entry->memdesc);
 	entry->priv->stats[type].cur -= entry->memdesc.size;
+	kgsl_trace_gpu_mem(entry->priv, -(int64_t)entry->memdesc.size);
 
 	spin_unlock(&entry->priv->mem_lock);
 
diff --git a/drivers/gpu/msm/kgsl_device.h b/drivers/gpu/msm/kgsl_device.h
index 556ee78a9100..d819aed541a3 100644
--- a/drivers/gpu/msm/kgsl_device.h
+++ b/drivers/gpu/msm/kgsl_device.h
@@ -560,12 +560,15 @@ struct kgsl_snapshot_object {
 
 struct kgsl_device *kgsl_get_device(int dev_idx);
 
+void kgsl_trace_gpu_mem(struct kgsl_process_private *priv, int64_t delta);
+
 static inline void kgsl_process_add_stats(struct kgsl_process_private *priv,
 	unsigned int type, uint64_t size)
 {
 	priv->stats[type].cur += size;
 	if (priv->stats[type].max < priv->stats[type].cur)
 		priv->stats[type].max = priv->stats[type].cur;
+	kgsl_trace_gpu_mem(priv, (int64_t)size);
 }
 
 static inline bool kgsl_is_register_offset(struct kgsl_device *device,
diff --git a/drivers/gpu/trace/Kconfig b/drivers/gpu/trace/Kconfig
new file mode 100644
index 000000000000..0964757653aa
--- /dev/null
+++ b/drivers/gpu/trace/Kconfig
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config TRACE_GPU_MEM
+	bool
diff --git a/drivers/gpu/trace/Makefile b/drivers/gpu/trace/Makefile
new file mode 100644
index 000000000000..5aed2d67491f
--- /dev/null
+++ b/drivers/gpu/trace/Makefile
@@ -0,0 +1,2 @@
+# SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_TRACE_GPU_MEM) += trace_gpu_mem.o
diff --git a/drivers/gpu/trace/trace_gpu_mem.c b/drivers/gpu/trace/trace_gpu_mem.c
new file mode 100644
index 000000000000..01e855897b6d
--- /dev/null
+++ b/drivers/gpu/trace/trace_gpu_mem.c
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * GPU memory trace points
+ *
+ * Copyright (C) 2020 Google, Inc.
+ */
+
+#include <linux/module.h>
+
+#define CREATE_TRACE_POINTS
+#include <trace/events/gpu_mem.h>
+
+EXPORT_TRACEPOINT_SYMBOL(gpu_mem_total);
diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
index 007151796f10..d9037bb405bf 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -15,6 +15,8 @@ source "drivers/char/agp/Kconfig"
 
 source "drivers/gpu/vga/Kconfig"
 
+source "drivers/gpu/trace/Kconfig"
+
 source "drivers/gpu/host1x/Kconfig"
 source "drivers/gpu/ipu-v3/Kconfig"
 source "drivers/gpu/msm/Kconfig"
diff --git a/include/trace/events/gpu_mem.h b/include/trace/events/gpu_mem.h
new file mode 100644
index 000000000000..4dcc3f0483c4
--- /dev/null
+++ b/include/trace/events/gpu_mem.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * GPU memory trace points
+ *
+ * Copyright (C) 2020 Google, Inc.
+ */
+
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM gpu_mem
+
+#if !defined(_TRACE_GPU_MEM_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_GPU_MEM_H
+
+#include <linux/tracepoint.h>
+
+/*
+ * The gpu_memory_total event indicates that there's an update to either the
+ * global or process total gpu memory counters.
+ *
+ * This event should be emitted whenever the kernel device driver observes
+ * a change in: total GPU memory, or the GPU memory attributed to a process.
+ *
+ * @gpu_id: This is the gpu id.
+ *
+ * @pid: Put 0 for global total, while positive pid for process total.
+ *
+ * @size: Size of the allocation in bytes.
+ *
+ */
+TRACE_EVENT(gpu_mem_total,
+
+	TP_PROTO(uint32_t gpu_id, uint32_t pid, uint64_t size),
+
+	TP_ARGS(gpu_id, pid, size),
+
+	TP_STRUCT__entry(
+		__field(uint32_t, gpu_id)
+		__field(uint32_t, pid)
+		__field(uint64_t, size)
+	),
+
+	TP_fast_assign(
+		__entry->gpu_id = gpu_id;
+		__entry->pid = pid;
+		__entry->size = size;
+	),
+
+	TP_printk("gpu_id=%u pid=%u size=%llu",
+		__entry->gpu_id,
+		__entry->pid,
+		__entry->size)
+);
+
+#endif /* _TRACE_GPU_MEM_H */
+
+/* This part must be outside protection */
+#include <trace/define_trace.h>
