+    ],
+
+    // vintf manifest fragments, which is installed in /vendor/etc/vintf.
+    // TODO(b/130058564): should we put vintf framgments within the apex?
+    vintf_fragments: [
+        "com.android.vibrator.drv2624.xml",
+    ],
+    // END of companion filse
+}
