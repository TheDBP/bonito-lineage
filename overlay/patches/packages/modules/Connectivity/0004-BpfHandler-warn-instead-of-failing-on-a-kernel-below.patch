From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Mon, 21 Sep 2026 09:49:28 -0400
Subject: [PATCH] BpfHandler: warn instead of failing on a kernel below 5.4

netd's BpfHandler::init returns an Error on a V+ platform with a kernel
below 4.19 and on 25Q2+ below 5.4, which NetdUpdatable turns into an
abort() and a netd restart loop. Warn and carry on; every program and
map the rest of init touches is already gated on the kernel version.

---
 bpf/netd/BpfHandler.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/bpf/netd/BpfHandler.cpp b/bpf/netd/BpfHandler.cpp
index 9b57548b54..2535e00d62 100644
--- a/bpf/netd/BpfHandler.cpp
+++ b/bpf/netd/BpfHandler.cpp
@@ -131,12 +131,12 @@ static Result<void> initPrograms(const char* cg2_path) {
 
     // V bumps the kernel requirement up to 4.19
     if (isAtLeastV && !isAtLeastKernelVersion(4, 19)) {
-        return Error() << "V+ platform with kernel version < 4.19.0 is unsupported";
+        ALOGW("V+ platform with kernel version < 4.19.0 is unsupported");
     }
 
     // 25Q2 bumps the kernel requirement up to 5.4
     if (isAtLeast25Q2 && !isAtLeastKernelVersion(5, 4)) {
-        return Error() << "25Q2+ platform with kernel version < 5.4.0 is unsupported";
+        ALOGW("25Q2+ platform with kernel version < 5.4.0 is unsupported");
     }
 
     unique_fd cg_fd(open(cg2_path, O_DIRECTORY | O_RDONLY | O_CLOEXEC));
