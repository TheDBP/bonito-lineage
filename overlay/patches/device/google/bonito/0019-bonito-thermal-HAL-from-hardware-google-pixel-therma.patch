From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Sun, 20 Sep 2026 11:54:36 -0400
Subject: [PATCH] bonito: thermal HAL from hardware/google/pixel/thermal,
 sepolicy folded in

gs-common's thermal_hal/device.mk (dropped in 0005) only packaged
android.hardware.thermal-service.pixel + thermal_symlinks and added
gs-common/thermal/sepolicy/thermal_hal to the policy. Do both here: the HAL
source is hardware/google/pixel/thermal, which gained a soong_namespace on
24.0 so it also joins PRODUCT_SOONG_NAMESPACES; the sepolicy is a verbatim
copy of the 22.2 gs-common dir under sepolicy/vendor/google/thermal.
Without it hardware/google/pixel-sepolicy/power-libperfmgr fails checkpolicy
on thermal_link_device and vendor_thermal_prop. Same as coral 0d401e37.
---
 device.mk                                       |  7 +++++++
 sepolicy/bonito-sepolicy.mk                     |  3 +++
 sepolicy/vendor/google/thermal/file.te          |  2 ++
 sepolicy/vendor/google/thermal/file_contexts    |  6 ++++++
 sepolicy/vendor/google/thermal/genfs_contexts   |  3 +++
 .../google/thermal/hal_thermal_default.te       | 17 +++++++++++++++++
 .../google/thermal/init-thermal-logging.sh.te   | 10 ++++++++++
 .../google/thermal/init-thermal-symlinks.sh.te  | 12 ++++++++++++
 .../google/thermal/pixel-thermal-control.sh.te  | 13 +++++++++++++
 sepolicy/vendor/google/thermal/property.te      |  2 ++
 .../vendor/google/thermal/property_contexts     |  1 +
 sepolicy/vendor/google/thermal/vendor_init.te   |  3 +++
 12 files changed, 79 insertions(+)
 create mode 100644 sepolicy/vendor/google/thermal/file.te
 create mode 100644 sepolicy/vendor/google/thermal/file_contexts
 create mode 100644 sepolicy/vendor/google/thermal/genfs_contexts
 create mode 100644 sepolicy/vendor/google/thermal/hal_thermal_default.te
 create mode 100644 sepolicy/vendor/google/thermal/init-thermal-logging.sh.te
 create mode 100644 sepolicy/vendor/google/thermal/init-thermal-symlinks.sh.te
 create mode 100644 sepolicy/vendor/google/thermal/pixel-thermal-control.sh.te
 create mode 100644 sepolicy/vendor/google/thermal/property.te
 create mode 100644 sepolicy/vendor/google/thermal/property_contexts
 create mode 100644 sepolicy/vendor/google/thermal/vendor_init.te

diff --git a/device.mk b/device.mk
index 156b67d0..773fabd6 100644
--- a/device.mk
+++ b/device.mk
@@ -25,6 +25,7 @@ PRODUCT_SOONG_NAMESPACES += \
     hardware/google/pixel/health \
     hardware/google/pixel/pixelstats \
     hardware/google/pixel/power-libperfmgr \
+    hardware/google/pixel/thermal \
     hardware/google/pixel/usb \
     hardware/qcom/audio \
     hardware/qcom/sdm845/display \
@@ -723,6 +724,12 @@ PRODUCT_VENDOR_PROPERTIES += ro.soc.model=SDM670
 # HAL went with it. No haptics until it is vendored back from the 22.2 tree, which still has it.
 #include hardware/google/pixel/vibrator/drv2624/device.mk
 include hardware/google/pixel/mm/device_legacy.mk
+# Thermal. gs-common's thermal_hal/device.mk is gone on lineage-24.0; it only ever packaged the
+# HAL from hardware/google/pixel/thermal and named its sepolicy dir, both now done here (the
+# sepolicy copied verbatim to sepolicy/vendor/google/thermal, as coral did).
+PRODUCT_PACKAGES += \
+    android.hardware.thermal-service.pixel \
+    thermal_symlinks
 
 # Citadel
 include hardware/google/pixel/citadel/citadel.mk
diff --git a/sepolicy/bonito-sepolicy.mk b/sepolicy/bonito-sepolicy.mk
index a7c323f7..b7028785 100644
--- a/sepolicy/bonito-sepolicy.mk
+++ b/sepolicy/bonito-sepolicy.mk
@@ -15,3 +15,6 @@ SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += device/google/bonito/sepolicy/system_ext/pri
 BOARD_VENDOR_SEPOLICY_DIRS += hardware/google/pixel-sepolicy/confirmationui_hal
 BOARD_VENDOR_SEPOLICY_DIRS += hardware/google/pixel-sepolicy/ramdump/common
 BOARD_VENDOR_SEPOLICY_DIRS += hardware/google/pixel-sepolicy/powerstats
+
+# thermal (was device/google/gs-common/thermal/sepolicy/thermal_hal)
+BOARD_VENDOR_SEPOLICY_DIRS += device/google/bonito/sepolicy/vendor/google/thermal
diff --git a/sepolicy/vendor/google/thermal/file.te b/sepolicy/vendor/google/thermal/file.te
new file mode 100644
index 00000000..a2b1ab85
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/file.te
@@ -0,0 +1,2 @@
+type thermal_link_device, dev_type;
+type debugfs_thermal, debugfs_type, fs_type;
diff --git a/sepolicy/vendor/google/thermal/file_contexts b/sepolicy/vendor/google/thermal/file_contexts
new file mode 100644
index 00000000..c3fb04fe
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/file_contexts
@@ -0,0 +1,6 @@
+/vendor/bin/hw/android\.hardware\.thermal@2\.0-service\.pixel                     u:object_r:hal_thermal_default_exec:s0
+/vendor/bin/hw/android\.hardware\.thermal-service\.pixel                          u:object_r:hal_thermal_default_exec:s0
+/vendor/bin/thermal_logd                                                          u:object_r:init-thermal-logging-sh_exec:s0
+/vendor/bin/thermal_controld                                                      u:object_r:pixel-thermal-control-sh_exec:s0
+/vendor/bin/thermal_symlinks                                                      u:object_r:init-thermal-symlinks-sh_exec:s0
+/dev/thermal(/.*)?                                                                u:object_r:thermal_link_device:s0
diff --git a/sepolicy/vendor/google/thermal/genfs_contexts b/sepolicy/vendor/google/thermal/genfs_contexts
new file mode 100644
index 00000000..3000fa0a
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/genfs_contexts
@@ -0,0 +1,3 @@
+genfscon sysfs /devices/virtual/thermal                                        u:object_r:sysfs_thermal:s0
+genfscon sysfs /class/thermal                                                  u:object_r:sysfs_thermal:s0
+genfscon debugfs /gs101-thermal                                                u:object_r:debugfs_thermal:s0
diff --git a/sepolicy/vendor/google/thermal/hal_thermal_default.te b/sepolicy/vendor/google/thermal/hal_thermal_default.te
new file mode 100644
index 00000000..41a0f5e8
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/hal_thermal_default.te
@@ -0,0 +1,17 @@
+allow hal_thermal_default sysfs_thermal:dir r_dir_perms;
+allow hal_thermal_default sysfs_thermal:file rw_file_perms;
+allow hal_thermal_default sysfs_thermal:lnk_file r_file_perms;
+allow hal_thermal_default thermal_link_device:dir r_dir_perms;
+allow hal_thermal_default proc_stat:file r_file_perms;
+allow hal_thermal_default self:netlink_generic_socket create_socket_perms_no_ioctl;
+allow hal_thermal_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
+allow hal_thermal_default sysfs_gpu:file r_file_perms;
+
+hal_client_domain(hal_thermal_default, hal_power);
+
+# read thermal_config
+get_prop(hal_thermal_default, vendor_thermal_prop)
+
+# Needed for reporting thermal stats event
+allow hal_thermal_default fwk_stats_service:service_manager find;
+binder_call(hal_thermal_default, servicemanager)
diff --git a/sepolicy/vendor/google/thermal/init-thermal-logging.sh.te b/sepolicy/vendor/google/thermal/init-thermal-logging.sh.te
new file mode 100644
index 00000000..3da540e3
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/init-thermal-logging.sh.te
@@ -0,0 +1,10 @@
+type init-thermal-logging-sh, domain;
+type init-thermal-logging-sh_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(init-thermal-logging-sh)
+
+userdebug_or_eng(`
+  allow init-thermal-logging-sh vendor_toolbox_exec:file rx_file_perms;
+  allow init-thermal-logging-sh sysfs_thermal:dir r_dir_perms;
+  allow init-thermal-logging-sh sysfs_thermal:file r_file_perms;
+')
diff --git a/sepolicy/vendor/google/thermal/init-thermal-symlinks.sh.te b/sepolicy/vendor/google/thermal/init-thermal-symlinks.sh.te
new file mode 100644
index 00000000..093512c9
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/init-thermal-symlinks.sh.te
@@ -0,0 +1,12 @@
+type init-thermal-symlinks-sh, domain;
+type init-thermal-symlinks-sh_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(init-thermal-symlinks-sh)
+
+allow init-thermal-symlinks-sh vendor_toolbox_exec:file rx_file_perms;
+allow init-thermal-symlinks-sh thermal_link_device:dir rw_dir_perms;
+allow init-thermal-symlinks-sh thermal_link_device:lnk_file create_file_perms;
+allow init-thermal-symlinks-sh sysfs_thermal:dir r_dir_perms;
+allow init-thermal-symlinks-sh sysfs_thermal:file r_file_perms;
+allow init-thermal-symlinks-sh sysfs_thermal:lnk_file r_file_perms;
+set_prop(init-thermal-symlinks-sh, vendor_thermal_prop)
diff --git a/sepolicy/vendor/google/thermal/pixel-thermal-control.sh.te b/sepolicy/vendor/google/thermal/pixel-thermal-control.sh.te
new file mode 100644
index 00000000..df699fc6
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/pixel-thermal-control.sh.te
@@ -0,0 +1,13 @@
+type pixel-thermal-control-sh, domain;
+type pixel-thermal-control-sh_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(pixel-thermal-control-sh)
+
+userdebug_or_eng(`
+  allow pixel-thermal-control-sh vendor_toolbox_exec:file execute_no_trans;
+  allow pixel-thermal-control-sh sysfs_thermal:dir r_dir_perms;
+  allow pixel-thermal-control-sh sysfs_thermal:file rw_file_perms;
+  allow pixel-thermal-control-sh sysfs_thermal:lnk_file r_file_perms;
+  allow pixel-thermal-control-sh thermal_link_device:dir r_dir_perms;
+  set_prop(pixel-thermal-control-sh, vendor_thermal_prop)
+')
diff --git a/sepolicy/vendor/google/thermal/property.te b/sepolicy/vendor/google/thermal/property.te
new file mode 100644
index 00000000..676c85a2
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/property.te
@@ -0,0 +1,2 @@
+#thermal HAL
+vendor_internal_prop(vendor_thermal_prop)
diff --git a/sepolicy/vendor/google/thermal/property_contexts b/sepolicy/vendor/google/thermal/property_contexts
new file mode 100644
index 00000000..65a02ee8
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/property_contexts
@@ -0,0 +1 @@
+vendor.thermal.                           u:object_r:vendor_thermal_prop:s0
diff --git a/sepolicy/vendor/google/thermal/vendor_init.te b/sepolicy/vendor/google/thermal/vendor_init.te
new file mode 100644
index 00000000..aaf6ac1c
--- /dev/null
+++ b/sepolicy/vendor/google/thermal/vendor_init.te
@@ -0,0 +1,3 @@
+allow vendor_init thermal_link_device:dir r_dir_perms;
+allow vendor_init thermal_link_device:lnk_file r_file_perms;
+set_prop(vendor_init, vendor_thermal_prop)
