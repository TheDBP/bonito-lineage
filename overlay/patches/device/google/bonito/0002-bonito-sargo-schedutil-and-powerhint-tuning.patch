From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Mon, 21 Sep 2026 10:44:59 -0400
Subject: [PATCH] bonito/sargo: schedutil and powerhint tuning

Longer down_rate_limit_us on both clusters so the governor stops dropping frequency
between frames, and powerhint floors raised to match. Aimed at interaction smoothness
rather than benchmark peaks. The rc's top-app schedtune.boost is left alone: libperfmgr
resets that node to its powerhint default (10) on start, so an rc value never survives.
---
 init.hardware.rc | 4 ++--
 powerhint.json   | 7 ++++---
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/init.hardware.rc b/init.hardware.rc
index a00b945f..8d6557c1 100644
--- a/init.hardware.rc
+++ b/init.hardware.rc
@@ -104,12 +104,12 @@ on init && property:vendor.skip.init=0
     # configure governor settings for little cluster
     write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
     write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us 500
-    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us 20000
+    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us 30000
 
     # configure governor settings for big cluster
     write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor schedutil
     write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/up_rate_limit_us 500
-    write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/down_rate_limit_us 20000
+    write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/down_rate_limit_us 30000
 
     # set default schedTune value for foreground/top-app
     write /dev/stune/foreground/schedtune.prefer_idle 1
diff --git a/powerhint.json b/powerhint.json
index 15b72d3b..d00037d3 100644
--- a/powerhint.json
+++ b/powerhint.json
@@ -115,6 +115,7 @@
       "Name": "TASchedtuneBoost",
       "Path": "/dev/stune/top-app/schedtune.boost",
       "Values": [
+        "60",
         "50",
         "10"
       ],
@@ -250,19 +251,19 @@
       "PowerHint": "INTERACTION",
       "Node": "CPUBigClusterMinFreq",
       "Duration": 0,
-      "Value": "1132800"
+      "Value": "1363200"
     },
     {
       "PowerHint": "INTERACTION",
       "Node": "CPULittleClusterMinFreq",
       "Duration": 0,
-      "Value": "1209600"
+      "Value": "1324800"
     },
     {
       "PowerHint": "INTERACTION",
       "Node": "TASchedtuneBoost",
       "Duration": 0,
-      "Value": "50"
+      "Value": "60"
     },
     {
       "PowerHint": "INTERACTION",
