From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Mon, 21 Sep 2026 08:01:00 -0400
Subject: [PATCH] bonito: install ueventd.rc at /vendor/etc/ueventd.rc

Android 17 ueventd parses /system/etc/ueventd.rc only, which imports
/vendor/etc/ueventd.rc; the legacy /vendor/ueventd.rc path (still read
on pre-T first_api_level devices up to Android 16) was removed in
system/core 1b926a344. Without it no vendor device node gets its
permissions: /dev/kgsl-3d0, /dev/ion, /dev/qseecom and /dev/citadel0
stay 0600 root, so surfaceflinger, keymaster, gatekeeper and citadeld
abort in a loop and the phone sits on the Google logo.
---
 device.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/device.mk b/device.mk
index f931490e..20b7be38 100644
--- a/device.mk
+++ b/device.mk
@@ -93,7 +93,7 @@ PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/init.recovery.hardware.rc:recovery/root/init.recovery.$(PRODUCT_PLATFORM).rc \
     $(LOCAL_PATH)/init.hardware.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.$(PRODUCT_PLATFORM).rc \
     $(LOCAL_PATH)/init.hardware.usb.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.$(PRODUCT_PLATFORM).usb.rc \
-    $(LOCAL_PATH)/ueventd.hardware.rc:$(TARGET_COPY_OUT_VENDOR)/ueventd.rc \
+    $(LOCAL_PATH)/ueventd.hardware.rc:$(TARGET_COPY_OUT_VENDOR)/etc/ueventd.rc \
     $(LOCAL_PATH)/init.power.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.$(PRODUCT_PLATFORM).power.rc \
     $(LOCAL_PATH)/init.radio.sh:$(TARGET_COPY_OUT_VENDOR)/bin/init.radio.sh \
     $(LOCAL_PATH)/uinput-fpc.kl:$(TARGET_COPY_OUT_VENDOR)/usr/keylayout/uinput-fpc.kl \
