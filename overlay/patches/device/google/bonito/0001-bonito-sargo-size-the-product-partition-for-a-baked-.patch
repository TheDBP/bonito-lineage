From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Sun, 20 Sep 2026 15:35:43 -0400
Subject: [PATCH] bonito/sargo: size the partitions for what the build bakes in

Lineage reserves space in product (1000 MiB), system and system_ext (90 MiB each) so
GApps can be flashed after install; check_partition_sizes counts it against the
google_dynamic_partitions group (3880 MiB). A lineage-24.0 build with the OEM assets and
Syncthing-Fork in product stages about 4100 MiB with the full reservation (system 1018,
system_ext 400, product 823, vendor 564 MiB plus the reservations and ext4 overhead), so
no variant can keep it:

- GApps baked in (WITH_GAPPS) never flashes them. Trim product to 32 MiB and
  system/system_ext to 16 MiB each.
- Firefox without GApps (WITH_FIREFOX) adds 306 MB to product. Keep 128 MiB.
- Everything else keeps 512 MiB, about 250 MiB of the group to spare.
---
 BoardConfigLineage.mk | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/BoardConfigLineage.mk b/BoardConfigLineage.mk
index 47bf39a3..d7c40c8d 100644
--- a/BoardConfigLineage.mk
+++ b/BoardConfigLineage.mk
@@ -28,7 +28,21 @@ BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
 # Reserve space for gapps install
 -include vendor/lineage/config/BoardConfigReservedSize.mk
 ifneq ($(WITH_GMS),true)
-BOARD_PRODUCTIMAGE_PARTITION_RESERVED_SIZE := 1048576000
+# Lineage reserves space in product (1000 MiB), system and system_ext (90 MiB each) so GApps can
+# be flashed after install; check_partition_sizes counts it against BOARD_SUPER_PARTITION_SIZE
+# (the google_dynamic_partitions group, 3880 MiB). lineage-24.0 with the OEM assets and
+# Syncthing-Fork in product stages ~4100 MiB with the full reservation, so no variant keeps it:
+# GApps baked in never flashes them, so 32 MiB in product and 16 MiB in system/system_ext;
+# Firefox (306 MB in product) keeps 128 MiB; everything else keeps 512 MiB.
+ifeq ($(WITH_GAPPS),true)
+BOARD_PRODUCTIMAGE_PARTITION_RESERVED_SIZE := 33554432
+BOARD_SYSTEMIMAGE_PARTITION_RESERVED_SIZE := 16777216
+BOARD_SYSTEM_EXTIMAGE_PARTITION_RESERVED_SIZE := 16777216
+else ifeq ($(WITH_FIREFOX),true)
+BOARD_PRODUCTIMAGE_PARTITION_RESERVED_SIZE := 134217728
+else
+BOARD_PRODUCTIMAGE_PARTITION_RESERVED_SIZE := 536870912
+endif
 endif
 
 # SELinux
