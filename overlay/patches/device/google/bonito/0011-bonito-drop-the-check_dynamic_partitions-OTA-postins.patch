From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Sat, 19 Sep 2026 20:52:46 -0400
Subject: [PATCH 2/2] bonito: drop the check_dynamic_partitions OTA postinstall

hardware/google/pixel removed the script (bf2744d6 "pixel: Drop no longer
used check_dynamic_partitions script"). It guarded the one-time
retrofit from the non-dynamic-partition Android 9 layout; every device
that reaches this build is already on dynamic partitions.
PRODUCT_RETROFIT_DYNAMIC_PARTITIONS stays.
---
 device-common.mk | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/device-common.mk b/device-common.mk
index aeef9275..5ad712e4 100644
--- a/device-common.mk
+++ b/device-common.mk
@@ -102,15 +102,6 @@ PRODUCT_COPY_FILES += \
 # and sargo targets
 PRODUCT_USE_DYNAMIC_PARTITIONS := true
 PRODUCT_RETROFIT_DYNAMIC_PARTITIONS := true
-PRODUCT_PACKAGES += \
-    check_dynamic_partitions \
-
-AB_OTA_POSTINSTALL_CONFIG += \
-    RUN_POSTINSTALL_product=true \
-    POSTINSTALL_PATH_product=bin/check_dynamic_partitions \
-    FILESYSTEM_TYPE_product=ext4 \
-    POSTINSTALL_OPTIONAL_product=false \
-
 PRODUCT_DEFAULT_PROPERTY_OVERRIDES += \
     ro.surface_flinger.protected_contents=true \
     ro.surface_flinger.use_color_management=true \
