<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Android 17 (lineage-24.0) groundwork, 2026-09-17 (retargeted from the 23.2 skeleton).
       ElmyraService has a lineage-24.0 branch; gs-common stops at lineage-23.2. Everything else
       stays pinned at lineage-22.2, which is its newest:
         android_device_google_{sargo,bonito}  newest lineage-23.0, but that is a STRICT
           ANCESTOR of lineage-22.2 (branched 2025-08, abandoned) - 22.2 is the newer code.
         android_kernel_google_msm-4.9         newest lineage-22.2
         proprietary_vendor_google_{sargo,bonito}  newest lineage-22.2 - so this is an
           Android 17 platform running Android 15 blobs. Two version gap, same as ether-20.0
           carries, and hardware/lineage/compat exists for exactly this.
       Carrying those five forward ourselves IS the port, after the kernel gate in ANDROID-16.md. -->

  <!-- Pixel 3a (sargo) device tree + common chain (sargo -> bonito -> {gs-common, kernel, ElmyraService}). -->
  <project name="LineageOS/android_device_google_sargo"      path="device/google/sargo"      remote="github" revision="lineage-22.2" />
  <project name="LineageOS/android_device_google_bonito"     path="device/google/bonito"     remote="github" revision="lineage-22.2" />
  <project name="LineageOS/android_device_google_gs-common"  path="device/google/gs-common"  remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_kernel_google_msm-4.9"    path="kernel/google/msm-4.9"    remote="github" revision="lineage-22.2" />
  <project name="LineageOS/android_packages_apps_ElmyraService" path="packages/apps/ElmyraService" remote="github" revision="lineage-24.0" />
  <!-- Proprietary vendor blobs (TheMuppets, per-device: sargo + its bonito common). -->
  <project name="TheMuppets/proprietary_vendor_google_sargo"  path="vendor/google/sargo"  remote="github" revision="lineage-22.2" />
  <project name="TheMuppets/proprietary_vendor_google_bonito" path="vendor/google/bonito" remote="github" revision="lineage-22.2" />
</manifest>
